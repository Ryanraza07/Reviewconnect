import { useEffect, useMemo, useState } from 'react';
import { useParams } from 'react-router-dom';
import {
  Copy,
  Link2,
  MapPin,
  Phone,
  Sparkles,
  Star,
  Check,
  ChevronDown,
  Wand2,
  RefreshCw,
  Award,
  Clock,
  ThumbsUp,
  Quote,
  ExternalLink,
  Heart
} from 'lucide-react';
import toast, { Toaster } from 'react-hot-toast';
import api from '../services/api';
import { buildBusinessLocationHref } from '../utils/location';

const tones = [
  { key: 'simple', label: 'Simple', description: 'Clean & straightforward', emoji: '✨' },
  { key: 'natural', label: 'Natural', description: 'Conversational tone', emoji: '💬' },
  { key: 'professional', label: 'Professional', description: 'Formal & polished', emoji: '💼' },
  { key: 'detailed', label: 'Detailed', description: 'Thorough feedback', emoji: '📝' },
  { key: 'friendly', label: 'Friendly', description: 'Warm & casual', emoji: '😊' },
  { key: 'casual', label: 'Casual', description: 'Relaxed & informal', emoji: '🎉' }
];

const languages = [
  { key: 'English', label: 'English', flag: '🇺🇸' },
  { key: 'Hindi', label: 'हिंदी', flag: '🇮🇳' },
  { key: 'Hinglish', label: 'Hinglish', flag: '💬' }
];

const shuffleList = (items = []) => {
  const copy = [...items];
  for (let index = copy.length - 1; index > 0; index -= 1) {
    const swapIndex = Math.floor(Math.random() * (index + 1));
    [copy[index], copy[swapIndex]] = [copy[swapIndex], copy[index]];
  }
  return copy;
};

// Animated gradient background component
function AnimatedBackground() {
  return (
    <div className="absolute inset-0 -z-10 overflow-hidden">
      <div className="absolute -top-40 -right-40 h-80 w-80 animate-pulse rounded-full bg-gradient-to-br from-blue-400/20 to-cyan-300/20 blur-3xl" />
      <div className="absolute -bottom-40 -left-40 h-80 w-80 animate-pulse rounded-full bg-gradient-to-br from-purple-400/20 to-pink-300/20 blur-3xl" style={{ animationDelay: '1s' }} />
      <div className="absolute top-1/2 left-1/2 h-96 w-96 -translate-x-1/2 -translate-y-1/2 animate-pulse rounded-full bg-gradient-to-br from-emerald-400/10 to-teal-300/10 blur-3xl" style={{ animationDelay: '2s' }} />
    </div>
  );
}

export default function BusinessPage() {
  export default function BusinessPage() {
  const { slug } = useParams();
  const [business, setBusiness] = useState(null);
  const [loading, setLoading] = useState(true);
  const [selectedCategories, setSelectedCategories] = useState([]);
  const [tone, setTone] = useState('natural');
  const [language, setLanguage] = useState('Hinglish');
  const [businessSummary, setBusinessSummary] = useState('');
  const [reviewText, setReviewText] = useState('');
  const [isGenerating, setIsGenerating] = useState(false);
  const [copied, setCopied] = useState(false);

  useEffect(() => {
    const loadBusiness = async () => {
      try {
        const { data } = await api.get(`/businesses/${slug}`);
        setBusiness(data);
        setBusinessSummary(data.businessSummary || data.description || '');

        const enabledCategories = (data.reviewCategories || [])
          .filter((item) => item.enabled)
          .map((item) => item.key);
        const randomCount = Math.min(3, Math.max(2, enabledCategories.length > 3 ? 3 : enabledCategories.length));
        const defaults = shuffleList(enabledCategories).slice(0, Math.min(randomCount, enabledCategories.length));
        setSelectedCategories(defaults);
        setTone(data.templateSettings?.defaultTone || 'natural');

        const preferredLanguage = data.supportedLanguages?.length
          ? (data.supportedLanguages.includes('Hinglish') ? 'Hinglish' : data.supportedLanguages[0])
          : 'Hinglish';
        setLanguage(preferredLanguage);

        if (defaults.length) {
          try {
            const { data: preview } = await api.post('/reviews/generate', {
              businessSlug: data.slug,
              selectedCategories: defaults,
              tone: data.templateSettings?.defaultTone || 'natural',
              language: preferredLanguage,
              description: 'The team was warm, the experience felt smooth, and I would happily return.'
            });
            setReviewText(preview.review);
          } catch {
            setReviewText('Your review will appear here after generation.');
          }
        }
      } catch (error) {
        toast.error('Business not found.');
      } finally {
        setLoading(false);
      }
    };

    loadBusiness();
  }, [slug]);

  const totalCategories = useMemo(
    () => (business?.reviewCategories || []).filter((item) => item.enabled),
    [business]
  );

  const businessLocationHref = business ? buildBusinessLocationHref(business.location, business.locationLink) : '#';
  const businessPhoneHref = business?.contactNumber ? `tel:${String(business.contactNumber).replace(/[^\d+]/g, '')}` : '#';
  const trustStats = [
    { label: 'Local', value: 'Verified', icon: MapPin },
    { label: 'Reviews', value: '200+', icon: Link2 }
  ];

  const toggleCategory = (key) => {
    setSelectedCategories((current) =>
      current.includes(key) ? current.filter((item) => item !== key) : [...current, key]
    );
  };

  const handleGenerate = async () => {
    if (!selectedCategories.length) {
      toast.error('Select at least one review tag before generating.');
      return;
    }

    setIsGenerating(true);
    try {
      const { data } = await api.post('/reviews/generate', {
        businessSlug: slug,
        selectedCategories,
        tone,
        language,
        businessSummary
      });
      setReviewText(data.review);
      toast.success('Review generated successfully.');
    } catch (error) {
      toast.error(error.response?.data?.message || 'Could not generate the review.');
    } finally {
      setIsGenerating(false);
    }
  };

  const handleCopy = async () => {
    if (!reviewText) return;
    try {
      await navigator.clipboard.writeText(reviewText);
      await api.post('/reviews/track', {
        eventType: 'review-copy',
        businessSlug: slug,
        metadata: { tone, language }
      });
      toast.success('Review copied to clipboard.');
    } catch {
      toast.error('Copy failed. Please copy manually.');
    }
  };

  const handleGoogleRedirect = async () => {
    const target = business?.googleReviewUrl || `https://www.google.com/search?q=${encodeURIComponent(`${business?.businessName || 'Business'} reviews`)}`;

    if (reviewText.trim()) {
      try {
        await navigator.clipboard.writeText(reviewText);
      } catch {
        // fallback without blocking redirect
      }
    }

    await api.post('/reviews/track', {
      eventType: 'google-review-click',
      businessSlug: slug,
      metadata: { tone, language }
    });

    window.open(target, '_blank', 'noopener,noreferrer');
  };

  if (loading) {
    return (
      <div className="flex min-h-screen items-center justify-center bg-slate-950 text-white">
        <div className="rounded-full border border-white/10 bg-slate-900 px-5 py-3 text-sm text-slate-200">Loading business page...</div>
      </div>
    );
  }

  if (!business) {
    return (
      <div className="flex min-h-screen items-center justify-center bg-slate-950 text-white">
        <div className="rounded-2xl border border-red-500/30 bg-red-500/10 px-6 py-4 text-red-200">Business not found.</div>
      </div>
    );
  }

  const accentColor = business.branding?.primaryColor || '#2563eb';

  return (
    <div className="min-h-screen bg-[radial-gradient(circle_at_top_left,_rgba(59,130,246,0.18),transparent_18%),radial-gradient(circle_at_top_right,_rgba(236,72,153,0.12),transparent_18%),radial-gradient(circle_at_bottom,_rgba(16,185,129,0.10),transparent_28%),#f8fafc] text-slate-900">
      <Toaster position="top-right" />
      <div className="mx-auto max-w-6xl px-4 py-6 md:px-6">
        <header
          className="relative overflow-hidden rounded-[32px] border border-white/60 bg-gradient-to-br from-white via-sky-50 to-violet-50 p-5 shadow-[0_30px_100px_rgba(59,130,246,0.14)] backdrop-blur-xl md:p-6"
          style={{ boxShadow: `0 30px 100px ${accentColor}26` }}
        >
          <div className="absolute -right-12 -top-10 h-36 w-36 rounded-full bg-gradient-to-br from-cyan-300/60 to-violet-400/50 blur-2xl" />
          <div className="absolute -left-8 bottom-0 h-28 w-28 rounded-full bg-gradient-to-br from-amber-200/60 to-pink-300/40 blur-2xl" />
          <div className="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div className="flex items-center gap-4">
              <img
                src={business.logo || 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=120&q=80'}
                alt={business.businessName}
                className="h-16 w-16 rounded-2xl object-cover ring-4 ring-slate-100"
              />
              <div>
                <p className="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Review Connect</p>
                <h1 className="mt-1 text-2xl font-bold text-slate-900 md:text-3xl">{business.businessName}</h1>
              </div>
            </div>
            <div className="flex flex-wrap items-center gap-2">
              <div className="rounded-full px-4 py-2 text-sm font-medium shadow-sm" style={{ background: `${accentColor}1A`, color: accentColor }}>
                {business.category}
              </div>
              <div className="rounded-full border border-emerald-200 bg-gradient-to-r from-emerald-50 to-teal-50 px-3 py-2 text-xs font-semibold uppercase tracking-[0.12em] text-emerald-700 shadow-sm">
                Verified local
              </div>
            </div>
          </div>

          <div className="relative z-10 mt-5 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <p className="max-w-2xl text-base text-slate-600">{business.welcomeMessage}</p>
            <div className="flex flex-wrap gap-2">
              {business.contactNumber ? (
                <a
                  href={businessPhoneHref}
                  className="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:-translate-y-0.5 hover:bg-slate-50"
                >
                  <Phone size={14} className="text-sky-600" />
                  Call now
                </a>
              ) : null}
              {business.location ? (
                <a
                  href={businessLocationHref}
                  target="_blank"
                  rel="noreferrer"
                  className="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:-translate-y-0.5 hover:bg-slate-50"
                >
                  <MapPin size={14} className="text-violet-600" />
                  Get directions
                </a>
              ) : null}
              <button
                type="button"
                onClick={handleGoogleRedirect}
                className="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-emerald-500 to-teal-500 px-3 py-2 text-sm font-medium text-white shadow-[0_12px_30px_rgba(16,185,129,0.3)] transition hover:-translate-y-0.5 hover:shadow-[0_18px_30px_rgba(16,185,129,0.4)]"
              >
                <Link2 size={14} />
                Review on Google
              </button>
            </div>
          </div>

          <div className="relative z-10 mt-5 grid gap-3 sm:grid-cols-3">
            {trustStats.map(({ label, value, icon: Icon }) => (
              <div key={label} className="flex items-center gap-3 rounded-2xl border border-slate-200/80 bg-white/80 px-3 py-3 shadow-sm backdrop-blur-sm">
                <div className="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-sky-500 to-violet-500 text-white shadow-md shadow-sky-500/20">
                  <Icon size={15} />
                </div>
                <div>
                  <div className="text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-500">{label}</div>
                  <div className="mt-1 text-sm font-semibold text-slate-800">{value}</div>
                </div>
              </div>
            ))}
          </div>
        </header>

        <main className="mt-8 grid gap-6 lg:grid-cols-[1.08fr_0.92fr]">
          <section className="rounded-[32px] border border-slate-200/80 bg-gradient-to-br from-white via-sky-50/50 to-violet-50/80 p-5 shadow-[0_18px_45px_rgba(59,130,246,0.08)] backdrop-blur-sm md:p-6">
            <div className="mb-5 flex items-center gap-3">
              <div className="flex h-10 w-10 items-center justify-center rounded-2xl bg-gradient-to-br from-sky-500 to-violet-500 text-white shadow-lg shadow-sky-500/20">
                <Sparkles size={18} />
              </div>
              <p className="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">How was your experience?</p>
            </div>

            <div className="mb-6">
              <label className="mb-2 block text-sm font-medium text-slate-700">Business summary</label>
              <textarea
                value={businessSummary}
                onChange={(event) => setBusinessSummary(event.target.value)}
                rows={3}
                className="w-full rounded-2xl border border-sky-100 bg-white/80 px-3 py-3 text-sm text-slate-700 outline-none transition focus:border-sky-300 focus:ring-2 focus:ring-sky-500/10"
                placeholder="Neighborhood café known for artisan coffee, brunch, and a warm modern atmosphere."
              />
            </div>

            <div className="mb-6">
              <p className="mb-3 text-sm font-medium text-slate-700">Choose what mattered most</p>
              <div className="flex flex-wrap gap-2">
                {totalCategories.map((item) => (
                  <button
                    key={item.key}
                    type="button"
                    onClick={() => toggleCategory(item.key)}
                    className={`rounded-full border px-3 py-2 text-sm transition ${selectedCategories.includes(item.key)
                      ? 'border-sky-500 bg-gradient-to-r from-sky-500 to-violet-500 text-white shadow-[0_10px_24px_rgba(59,130,246,0.25)]'
                      : 'border-slate-200 bg-white/80 text-slate-700 hover:border-sky-200 hover:bg-sky-50'}`}
                  >
                    {item.name}
                  </button>
                ))}
              </div>
            </div>

            <div className="grid gap-4 md:grid-cols-2">
              <div>
                <label className="mb-2 block text-sm font-medium text-slate-700">Tone</label>
                <select
                  value={tone}
                  onChange={(event) => setTone(event.target.value)}
                  className="w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-3 text-sm text-slate-700 outline-none focus:border-slate-400"
                >
                  {tones.map((option) => (
                    <option key={option} value={option}>{option}</option>
                  ))}
                </select>
              </div>
              <div>
                <label className="mb-2 block text-sm font-medium text-slate-700">Language</label>
                <select
                  value={language}
                  onChange={(event) => setLanguage(event.target.value)}
                  className="w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-3 text-sm text-slate-700 outline-none focus:border-slate-400"
                >
                  {languages.map((option) => (
                    <option key={option} value={option}>{option}</option>
                  ))}
                </select>
              </div>
            </div>

            <div className="mt-6 grid gap-3 sm:grid-cols-2">
              <button
                type="button"
                onClick={handleGenerate}
                disabled={isGenerating}
                className="inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-blue-600 via-sky-500 to-violet-500 px-5 py-3 font-semibold text-white shadow-[0_16px_28px_rgba(59,130,246,0.3)] transition hover:-translate-y-0.5 hover:shadow-[0_18px_30px_rgba(59,130,246,0.38)] disabled:cursor-not-allowed disabled:opacity-70"
              >
                <Sparkles size={18} />
                {isGenerating ? 'Generating...' : 'Generate review'}
              </button>
              <button
                type="button"
                onClick={handleCopy}
                disabled={!reviewText}
                className="inline-flex items-center justify-center gap-2 rounded-full border border-violet-200 bg-gradient-to-r from-violet-50 to-fuchsia-50 px-5 py-3 font-semibold text-violet-700 transition hover:-translate-y-0.5 hover:shadow-sm disabled:cursor-not-allowed disabled:opacity-60"
              >
                <Copy size={18} /> Copy
              </button>
            </div>
          </section>

          <aside className="rounded-[32px] border border-slate-200/80 bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950 p-5 text-white shadow-[0_16px_45px_rgba(15,23,42,0.18)] md:p-6">
            <div className="flex items-center justify-between">
              <p className="text-sm font-semibold uppercase tracking-[0.18em] text-sky-200">Generated review</p>
              <span className="rounded-full border border-sky-400/30 bg-sky-400/10 px-2 py-1 text-[10px] font-medium uppercase tracking-[0.12em] text-sky-100">
                Ready
              </span>
            </div>

            <textarea
              value={reviewText || 'Your review will appear here after generation.'}
              onChange={(event) => setReviewText(event.target.value)}
              rows={12}
              className="mt-4 w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-50 outline-none transition placeholder:text-slate-400 focus:border-sky-300"
            />

            <div className="mt-6 grid gap-3 sm:grid-cols-2">
              <button
                type="button"
                onClick={handleGenerate}
                className="inline-flex items-center justify-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2.5 font-medium text-white transition hover:bg-white/10"
              >
                Regenerate
              </button>
              <button
                type="button"
                onClick={handleGoogleRedirect}
                className="inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-emerald-400 to-teal-500 px-4 py-2.5 font-medium text-white shadow-[0_14px_30px_rgba(16,185,129,0.32)] transition hover:-translate-y-0.5"
              >
                <Link2 size={16} /> Review on Google
              </button>
            </div>
          </aside>
        </main>

        {(business.location || business.contactNumber || business.contactName) && (
          <section className="mt-8">
            <div className="rounded-[30px] border border-slate-200/80 bg-white/80 p-4 shadow-[0_18px_45px_rgba(15,23,42,0.06)] backdrop-blur-sm md:p-5">
              {business.location ? (
                <a
                  href={businessLocationHref}
                  target="_blank"
                  rel="noreferrer"
                  className="block overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 transition hover:border-slate-300"
                >
                  <div className="h-36 w-full bg-slate-200">
                    <iframe
                      title={`${business.businessName} location`}
                      src={`https://www.google.com/maps?q=${encodeURIComponent(business.location)}&z=14&output=embed`}
                      className="h-full w-full border-0"
                      loading="lazy"
                      referrerPolicy="no-referrer-when-downgrade"
                    />
                  </div>
                  <div className="flex items-center justify-between gap-3 px-4 py-3">
                    <div>
                      <p className="text-xs font-semibold uppercase tracking-[0.15em] text-slate-500">Location</p>
                      <p className="mt-1 text-sm font-medium text-slate-700">{business.location}</p>
                    </div>
                    <span className="rounded-full bg-slate-900 p-2 text-white">
                      <MapPin size={16} />
                    </span>
                  </div>
                </a>
              ) : null}

              {(business.contactNumber || business.contactName) && (
                <div className="mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-4">
                  <p className="text-xs font-semibold uppercase tracking-[0.15em] text-slate-500">Contact</p>
                  {business.contactName ? (
                    <p className="mt-2 text-sm font-medium text-slate-700">{business.contactName}</p>
                  ) : null}
                  <div className="mt-3 flex flex-wrap gap-2">
                    {business.contactNumber ? (
                      <a
                        href={businessPhoneHref}
                        className="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100"
                      >
                        <Phone size={14} className="text-slate-500" />
                        Call now
                      </a>
                    ) : null}
                    {business.location ? (
                      <a
                        href={businessLocationHref}
                        target="_blank"
                        rel="noreferrer"
                        className="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100"
                      >
                        <MapPin size={14} className="text-slate-500" />
                        Get directions
                      </a>
                    ) : null}
                  </div>
                </div>
              )}
            </div>
          </section>
        )}
      </div>
    </div>
  );
}
